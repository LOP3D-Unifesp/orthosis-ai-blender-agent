# Runtime state — generated automatically by the addon at startup
/runtime/
/blender_addon/runtime/journal/
/blender_addon/runtime/sessions/
/blender_addon/runtime/sessions_v1/
# Belt-and-suspenders: chat_history and draft_history currently go to /runtime/ (covered above),
# but explicit entries guard against future path changes.
/blender_addon/runtime/chat_history/
/blender_addon/runtime/draft_history/

# Environment / secrets — never commit API keys or local paths
.env
*.env

# Python bytecode
**/__pycache__/
*.pyc
*.pyo

# Build artifacts
*.zip
dist/

# Claude Code workspace metadata
.claude/

# OS artifacts
.DS_Store
Thumbs.db

# Blender working files (too large, binary, churn-heavy — track separately if needed)
*.blend
*.blend1

# Local temp dirs
tmpn1o45sw2/
tmp*/
.claire/
