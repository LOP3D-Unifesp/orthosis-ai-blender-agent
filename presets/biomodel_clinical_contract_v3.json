  "principles": [
    "Biomodelo_v2 remains the shared raw engineering core",
    "BM_AJUSTE_SCAN_BASE_v1 remains an immutable legacy clinical reference",
    "all fine controls start at zero and are additive to the migrated base",
    "global long-finger length controls act on the same phalanx in D2-D5",
    "the MCP lateral master moves D2-D3 opposite D4-D5",
    "the palmar-arc master applies the same rotation to all four metacarpal rays",
    "per-finger palmar-arc controls only refine the common motion",
    "wrist flexion-extension and metacarpal setback remain available only as legacy controls"
  ],
  "panels": [
    {"id": "measures", "label": "1. Medidas do indivíduo", "default_closed": false},
    {"id": "lengths", "label": "2. Dimensões dos dedos", "default_closed": false},
    {"id": "fine_lengths", "label": "2a. Ajuste fino por falange", "parent": "lengths", "default_closed": true},
    {"id": "flexion", "label": "3. Flexão dos dedos", "default_closed": false},
    {"id": "fine_flexion", "label": "3a. Ajuste por dedo", "parent": "flexion", "default_closed": true},
    {"id": "opening_palm", "label": "4. Abertura e arco da palma", "default_closed": false},
