{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeJournalEvent",
  "type": "object",
  "required": [
    "type",
    "timestamp",
    "session_id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "goal_start",
        "goal_strategy",
        "tool_call",
        "operation",
        "code_execution",
        "runtime_event",
        "goal_end"
      ]
    },
    "timestamp": { "type": "string" },
    "session_id": { "type": "string" },
    "goal_id": { "type": "string" },
    "event_type": { "type": "string" },
    "status": { "type": "string" },
    "payload": { "type": "object" },
    "tool_name": { "type": "string" },
    "payload_size": { "type": "integer" },
    "result_size": { "type": "integer" },
    "round_time_ms": { "type": "integer" },
    "tool_args_preview": { "type": "string" },
    "tool_result_preview": { "type": "string" },
    "routing_reason": { "type": "string" },
    "tree_name": { "type": "string" },
    "node_name": { "type": "string" },
    "source_route": { "type": "string" },
    "used_structured_tool": { "type": "boolean" },
    "fallback_to_execute_code_reason": { "type": "string" },
    "structured_tool_available": { "type": ["boolean", "null"] },
    "execute_code_inevitable": { "type": ["boolean", "null"] },
    "metadata": { "type": "object" },
    "dashboard": { "type": "object" }
  }
}
